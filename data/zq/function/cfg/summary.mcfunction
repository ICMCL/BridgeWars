execute if score #o_bridge zq_var matches 1 if score #t_bed zq_var matches 1.. run tellraw @a [{text:"  基岩桥：开局后 ",color:"gray"},{score:{name:"#t_bed",objective:"zq_var"},color:"aqua"},{text:"s",color:"gray"}]
