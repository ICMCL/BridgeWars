# 设置对话框模板（打开时按当前设置填好初始值再显示）
data modify storage zq:dlg rules set value {"type": "minecraft:confirmation", "title": {"text": "规则设置", "color": "gold"}, "pause": false, "body": {"type": "minecraft:plain_message", "contents": {"text": "下一局开始时生效。", "color": "gray"}, "width": 320}, "inputs": [{"type": "minecraft:single_option", "key": "br", "label": "桥", "width": 320, "options": [{"id": "0", "display": "不生成桥（全靠自己搭）"}, {"id": "1", "display": "分阶段：无桥→间断桥→完整桥→基岩桥"}, {"id": "2", "display": "开局就有完整桥（可破坏，不会变基岩）"}]}, {"type": "minecraft:boolean", "key": "pu", "label": "两座岛缓慢靠近（定期抽走中间的方块）", "initial": false, "on_true": "1", "on_false": "0"}, {"type": "minecraft:boolean", "key": "sh", "label": "商店（金币、道具、升级；关闭后仍可免费换职业）", "initial": false, "on_true": "1", "on_false": "0"}, {"type": "minecraft:boolean", "key": "po", "label": "毒墙从两侧收拢（最后只剩中间 3 格宽，墙外持续掉血）", "initial": false, "on_true": "1", "on_false": "0"}, {"type": "minecraft:boolean", "key": "sd", "label": "死斗（到时间后死亡不再复活）", "initial": false, "on_true": "1", "on_false": "0"}, {"type": "minecraft:boolean", "key": "rs", "label": "死亡递增复活（首次秒活，每死一次+1秒，最多10秒）", "initial": false, "on_true": "1", "on_false": "0"}, {"type": "minecraft:single_option", "key": "wi", "label": "获胜条件", "width": 320, "options": [{"id": "0", "display": "把对方旗帜带回自家旗台即可"}, {"id": "1", "display": "自家旗帜在家时，带回对方旗帜才算"}]}], "yes": {"label": {"text": "保存", "color": "green"}, "action": {"type": "dynamic/run_command", "template": "trigger zq_set set 1$(br)$(pu)$(sh)$(po)$(sd)$(rs)$(wi)"}}, "no": {"label": "取消"}}
data modify storage zq:dlg times set value {"type": "minecraft:confirmation", "title": {"text": "阶段时间", "color": "gold"}, "pause": false, "body": {"type": "minecraft:plain_message", "contents": {"text": "只对已开启的机制生效。桥从上一个开启阶段计时，没有则从开局算；关闭阶段不生成桥，也不占等待时间。其他机制的开始时间仍从开局算。", "color": "gray"}, "width": 320}, "inputs": [{"type": "minecraft:single_option", "key": "gap", "label": "间断桥：开局后等待", "width": 320, "options": [{"id": "0", "display": "1分钟"}, {"id": "1", "display": "2分钟"}, {"id": "2", "display": "3分钟"}, {"id": "3", "display": "5分钟"}, {"id": "4", "display": "8分钟"}, {"id": "5", "display": "关闭"}]}, {"type": "minecraft:single_option", "key": "full", "label": "完整桥：上一开启阶段后等待", "width": 320, "options": [{"id": "0", "display": "2分钟"}, {"id": "1", "display": "4分钟"}, {"id": "2", "display": "6分钟"}, {"id": "3", "display": "10分钟"}, {"id": "4", "display": "15分钟"}, {"id": "5", "display": "关闭"}]}, {"type": "minecraft:single_option", "key": "bed", "label": "基岩桥：上一开启阶段后等待", "width": 320, "options": [{"id": "0", "display": "4分钟"}, {"id": "1", "display": "6分钟"}, {"id": "2", "display": "10分钟"}, {"id": "3", "display": "15分钟"}, {"id": "4", "display": "30分钟"}, {"id": "5", "display": "关闭"}]}, {"type": "minecraft:single_option", "key": "ps", "label": "开局后多久两岛开始靠近", "width": 320, "options": [{"id": "0", "display": "30秒"}, {"id": "1", "display": "1分钟"}, {"id": "2", "display": "2分钟"}, {"id": "3", "display": "5分钟"}, {"id": "4", "display": "10分钟"}]}, {"type": "minecraft:single_option", "key": "pi", "label": "两岛每隔多久靠近一次", "width": 320, "options": [{"id": "0", "display": "10秒"}, {"id": "1", "display": "20秒"}, {"id": "2", "display": "30秒"}, {"id": "3", "display": "1分钟"}, {"id": "4", "display": "2分钟"}]}, {"type": "minecraft:single_option", "key": "xs", "label": "开局后多久毒墙开始收拢", "width": 320, "options": [{"id": "0", "display": "3分钟"}, {"id": "1", "display": "5分钟"}, {"id": "2", "display": "10分钟"}, {"id": "3", "display": "15分钟"}, {"id": "4", "display": "25分钟"}]}, {"type": "minecraft:single_option", "key": "xd", "label": "毒墙收拢到 3 格用时", "width": 320, "options": [{"id": "0", "display": "1分钟"}, {"id": "1", "display": "2分钟"}, {"id": "2", "display": "3分钟"}, {"id": "3", "display": "5分钟"}, {"id": "4", "display": "10分钟"}]}, {"type": "minecraft:single_option", "key": "sd", "label": "开局后多久进入死斗（不再复活）", "width": 320, "options": [{"id": "0", "display": "5分钟"}, {"id": "1", "display": "8分钟"}, {"id": "2", "display": "12分钟"}, {"id": "3", "display": "20分钟"}, {"id": "4", "display": "30分钟"}]}], "yes": {"label": {"text": "保存", "color": "green"}, "action": {"type": "dynamic/run_command", "template": "trigger zq_time set 1$(gap)$(full)$(bed)$(ps)$(pi)$(xs)$(xd)$(sd)"}}, "no": {"label": "取消"}}
